# Environment Configuration for SMKS Muhammadiyah 2 Genteng Face Attendance System
# Database SQLite (Bawaan lokal tanpa setup rumit) atau PostgreSQL (opsional untuk produksi)
DATABASE_URL="file:./dev.db"

# Server Timezone (Wajib Asia/Jakarta untuk WIB)
TIMEZONE="Asia/Jakarta"

# Node Environment
NODE_ENV="development"

# Port (Bawaan 3000)
PORT=3000
